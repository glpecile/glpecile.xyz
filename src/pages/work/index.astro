---
import Icon from "@/components/icon.astro";
import PageIntro from "@/components/page-intro.astro";
import SectionLabel from "@/components/section-label.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import WorkTimeline from "@/components/work-timeline.astro";
import { cvDownloadName } from "@/lib/cv";
import { parseInlineLinks } from "@/lib/inline-links";

import { siteConfig } from "#config/site";
import type {
	CertificateItem,
	ContactInfo,
	CvFile,
	EducationItem,
	LanguageItem,
	ProjectEntry,
	SkillGroup,
	WorkExperience,
} from "#config/site";

const work: readonly WorkExperience[] = siteConfig.work;
const projects: readonly ProjectEntry[] = siteConfig.projects;
const skills: readonly SkillGroup[] = siteConfig.skills;
const education: readonly EducationItem[] = siteConfig.education;
const languages: readonly LanguageItem[] = siteConfig.languages;
const certificates: readonly CertificateItem[] = siteConfig.certificates;
const cv: CvFile = siteConfig.cv;
const contact: ContactInfo = siteConfig.contact;
const cvFileName = cvDownloadName();
---

<SiteLayout
	title="Work"
	description="Work history, projects, skills, education, languages, certificates, and a downloadable CV."
	path="/work"
	previewPath="/work/preview"
>
	<section class="space-y-5">
		<PageIntro
			title="Past work experience."
			description="+ projects, skills, education & certificates."
		/>

		<div class="space-y-2" data-reveal>
			<p class="flex flex-wrap items-center gap-x-5 gap-y-1">
				<a class="action" href={cv.href} download={cvFileName} data-download>
					<Icon name="download" swap />
					{cv.label}
				</a>
				<a class="action" href="/work/index.html.md">
					<Icon name="markdown" />
					markdown
				</a>
			</p>
			<p class="text-tone-soft text-sm">{contact.email}, {contact.location}</p>
		</div>
	</section>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="roles" />

		{work.length === 0 ? (
			<p class="text-tone-soft text-sm">no work yet.</p>
		) : (
			<WorkTimeline work={work} detail="highlights" />
		)}
	</section>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="projects" count={projects.length} />

		{projects.length === 0 ? (
			<p class="text-tone-soft text-sm">no projects yet.</p>
		) : (
			<ol class="space-y-4">
				{projects.map((project) => (
					<li class="card group relative space-y-2 p-5">
						<p class="flex items-start justify-between gap-4 font-[575]">
							{project.url ? (
								<a
									class="no-underline after:absolute after:inset-0 after:rounded-[inherit]"
									href={project.url}
									target="_blank"
									rel="noopener noreferrer"
									data-hello={project.url === siteConfig.siteUrl ? "" : undefined}
								>
									{project.name}
								</a>
							) : (
								<span class="text-foreground">{project.name}</span>
							)}
							{project.url && (
								<svg
									viewBox="0 0 16 16"
									aria-hidden="true"
									class="text-tone-faint group-hover:text-link mt-1 h-4 w-4 shrink-0 fill-current transition-[rotate,color] duration-200 ease-(--ease-reveal) group-hover:rotate-45 motion-reduce:transition-none"
								>
									<path d="M3.75 4a.75.75 0 0 0 0 1.5h6.69l-7.22 7.22a.75.75 0 1 0 1.06 1.06l7.22-7.22v6.69a.75.75 0 0 0 1.5 0V4.75A.75.75 0 0 0 12.25 4h-8.5Z" />
								</svg>
							)}
						</p>
						<ul class="flex flex-wrap gap-1.5">
							{project.stack.split(" / ").map((tech) => (
								<li class="bg-muted text-tone-soft rounded-md px-1.5 py-0.5 font-mono text-xs">
									{tech}
								</li>
							))}
						</ul>
						{project.period && (
							<p class="text-tone-soft text-sm">
								{project.period}
							</p>
						)}
						<ul class="marker:text-tone-faint text-tone-mid list-disc space-y-1.5 pt-1 pl-4">
							{project.highlights.map((highlight) => (
								<li>
									{parseInlineLinks(highlight).map((segment) =>
										segment.url ? (
											<a class="site-link relative z-10" href={segment.url}>
												{segment.text}
											</a>
										) : (
											segment.text
										),
									)}
								</li>
							))}
						</ul>
					</li>
				))}
			</ol>
		)}
	</section>

	<p
		data-toast
		role="status"
		class="bg-card text-foreground pointer-events-none fixed bottom-6 left-1/2 z-50 -translate-x-1/2 translate-y-2 rounded-full px-4 py-2 font-mono text-sm opacity-0 shadow-[0_0_0_1px_hsl(var(--foreground)/0.07),0_4px_12px_hsl(var(--foreground)/0.08)] transition-[opacity,translate] duration-200 ease-(--ease-reveal) data-show:translate-y-0 data-show:opacity-100 motion-reduce:translate-y-0"
	></p>

	<script is:inline>
		(() => {
			// Easter egg: the card for this site greets you instead of reopening it.
			const hello = document.querySelector("[data-hello]");
			const toast = document.querySelector("[data-toast]");
			let toastTimer = 0;

			hello?.addEventListener("click", (event) => {
				if (!toast || event.metaKey || event.ctrlKey || event.shiftKey) return;
				event.preventDefault();
				window.clearTimeout(toastTimer);
				toast.textContent = "hello there.";
				toast.dataset.show = "";
				toastTimer = window.setTimeout(() => delete toast.dataset.show, 2000);
			});
		})();

		(() => {
			// Show the check on the download link for a moment after a click.
			const link = document.querySelector("[data-download]");
			let timer = 0;

			link?.addEventListener("click", () => {
				window.clearTimeout(timer);
				link.dataset.copyState = "success";
				timer = window.setTimeout(() => delete link.dataset.copyState, 1600);
			});
		})();
	</script>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="skills" />

		<ul class="grid gap-y-2">
			{skills.map((group) => (
				<li class="grid gap-1 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-4">
					<p class="text-foreground">{group.category}</p>
					<p class="text-tone-soft text-sm">
						{group.items.join(", ")}
					</p>
				</li>
			))}
		</ul>
	</section>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="education" />

		{education.length === 0 ? (
			<p class="text-tone-soft text-sm">no education yet.</p>
		) : (
			<ol class="space-y-5">
				{education.map((item) => (
					<li class="space-y-1">
						<p class="font-[575]">
							{item.url ? (
								<a
									class="site-link"
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									{item.school}
								</a>
							) : (
								<span class="text-foreground">{item.school}</span>
							)}
						</p>
						<p class="text-tone-soft text-sm">
							{item.credential}
						</p>
						<p class="text-tone-soft text-sm">
							{item.period}
						</p>
						{item.details?.map((detail) => (
							<p class="text-tone-mid">
								{detail}
							</p>
						))}
					</li>
				))}
			</ol>
		)}
	</section>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="languages" />

		<ul class="grid gap-y-2">
			{languages.map((item) => (
				<li class="grid gap-1 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-4">
					<p class="text-foreground">{item.language}</p>
					<p class="text-tone-soft text-sm">{item.level}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="certificates" />

		{certificates.length === 0 ? (
			<p class="text-tone-soft text-sm">no certificates yet.</p>
		) : (
			<ol class="space-y-5">
				{certificates.map((certificate) => (
					<li class="space-y-1">
						<p class="font-[575]">
							{certificate.url ? (
								<a
									class="site-link"
									href={certificate.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									{certificate.title}
								</a>
							) : (
								<span class="text-foreground">{certificate.title}</span>
							)}
						</p>
						<p class="text-tone-soft text-sm">
							{certificate.issuer}
						</p>
						<p class="text-tone-soft text-sm">
							Issued {certificate.issued}
						</p>
						{certificate.details?.map((detail) => (
							<p class="text-tone-mid">
								{detail}
							</p>
						))}
					</li>
				))}
			</ol>
		)}
	</section>
</SiteLayout>
