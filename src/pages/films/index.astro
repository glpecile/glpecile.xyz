---
import FilmListLoader from "@/components/film-list";
import MoreLink from "@/components/more-link.astro";
import PageIntro from "@/components/page-intro.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { withBlurPlaceholders } from "@/lib/blur";
import { getLetterboxdFilms } from "@/lib/letterboxd";

import { siteConfig } from "#config/site";

let films: Awaited<ReturnType<typeof withBlurPlaceholders>> = [];
try {
	films = await withBlurPlaceholders(
		await getLetterboxdFilms("Glp", { includeTags: true }),
	);
} catch {
	// Fail silently: the section will render an empty state.
}
---

<SiteLayout
	title="Films"
	description="Recently watched films, pulled from Letterboxd."
	path="/films"
	previewPath="/films/preview"
>
	<section class="space-y-5">
		<PageIntro
			title="Recently watched."
			description="A feed of films I've logged on Letterboxd."
		/>

		<p data-reveal>
			<MoreLink href={siteConfig.links.letterboxd} label="view all on letterboxd" external />
		</p>
	</section>

	<section class="space-y-4" data-reveal>
		<FilmListLoader client:load layout="timeline" allowLayoutSwitch tags films={films} />
	</section>

	<section class="space-y-3" data-reveal>
		<p>
			<MoreLink href={siteConfig.links.letterboxd} label="view all on letterboxd" external />
		</p>
	</section>
</SiteLayout>
