---
import FilmListLoader from "@/components/film-list";
import MoreLink from "@/components/more-link.astro";
import PageIntro from "@/components/page-intro.astro";
import SectionLabel from "@/components/section-label.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import WorkTimeline from "@/components/work-timeline.astro";
import { formatDate, getBlogPostUrl, getBlogPosts } from "@/lib/blog";
import { withBlurPlaceholders } from "@/lib/blur";
import { getLetterboxdFilms } from "@/lib/letterboxd";

import { siBluesky, siGithub, siX } from "simple-icons";

import { siteConfig } from "#config/site";
import type { WorkExperience } from "#config/site";

const socialIcons: Record<string, { title: string; path: string }> = {
	x: siX,
	bluesky: siBluesky,
	github: siGithub,
};
const socialLinks = Object.entries(siteConfig.links).filter(([label]) => label in socialIcons);
const posts = await getBlogPosts();
const latestPosts = posts.slice(0, 3);
const work: readonly WorkExperience[] = siteConfig.work;
const featuredWork = work.slice(0, 3);
const hasMoreWork = work.length > featuredWork.length;

let latestFilms: Awaited<ReturnType<typeof withBlurPlaceholders>> = [];
try {
	latestFilms = await withBlurPlaceholders(
		await getLetterboxdFilms("Glp", { limit: 4 }),
	);
} catch {
	// Fail silently: the section will render an empty state.
}

const kbd = (key: string) => `<span class="kbd">${key}</span>`;
const navShortcutCopy = siteConfig.shortcuts.nav
	.map((item) => `${kbd(item.shortcut)} ${item.title.toLowerCase()}`)
	.join(", ");
const introExtra = `Jump with ${navShortcutCopy}.<span class="block">Move through lists with ${kbd("j")} ${kbd("k")}, open with ${kbd("enter")}.</span><span class="block">Are you an agent? Start with <a class="site-link" href="/llms.txt">/llms.txt</a>.</span>`;
---

<SiteLayout>
	<PageIntro
		title="Software / Frontend Engineer."
		extra={introExtra}
	/>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="blog" />

		{latestPosts.length === 0 ? (
			<p class="text-tone-soft text-sm">no posts yet.</p>
		) : (
			<ol class="space-y-3">
				{latestPosts.map((post) => (
					<li data-tui-row class="flex items-baseline gap-3">
						<a class="min-w-0 no-underline" href={getBlogPostUrl(post.id)}>
							{post.data.title}
						</a>
						<span aria-hidden="true" class="border-border hidden min-w-4 flex-1 -translate-y-1 border-b border-dashed sm:block"></span>
						<time class="text-tone-faint ml-auto shrink-0 font-mono text-xs">
							{formatDate(post.data.updatedDate ?? post.data.pubDate).toLowerCase()}
						</time>
					</li>
				))}
			</ol>
		)}

		{posts.length > 0 && <MoreLink href="/blog" label="all posts" />}
	</section>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="work" />
		<WorkTimeline work={featuredWork} />
		{hasMoreWork && <MoreLink href="/work" label="full history" />}
	</section>

	<section class="space-y-4" data-reveal>
		<SectionLabel label="films" />
		<p class="text-tone-soft">
			Latest watches. Follow along on{" "}
			<a
				class="site-link"
				href={siteConfig.links.letterboxd}
				target="_blank"
				rel="noopener noreferrer"
			>
				Letterboxd
			</a>
			{" "}for the rest.
		</p>

		<FilmListLoader client:load limit={4} layout="grid" films={latestFilms} />

		<MoreLink href="/films" label="all films" />
	</section>

	<section class="space-y-3" data-reveal>
		<SectionLabel label="socials" />
		<ul class="flex flex-wrap gap-2.5">
			{socialLinks.map(([label, href]) => (
				<li>
					<a href={href} target="_blank" rel="noopener noreferrer" class="chip group">
						<svg
							viewBox="0 0 24 24"
							aria-hidden="true"
							class="text-tone-soft group-hover:text-link h-4 w-4 fill-current transition-colors duration-150"
						>
							<path d={socialIcons[label].path}></path>
						</svg>
						<span>{socialIcons[label].title}</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</SiteLayout>
