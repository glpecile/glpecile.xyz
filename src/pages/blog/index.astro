---
import { siteConfig } from "#config/site";

import Icon from "@/components/icon.astro";
import PageIntro from "@/components/page-intro.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { formatDate, getBlogPostUrl, getBlogPosts } from "@/lib/blog";

const posts = await getBlogPosts();
const latestPostCount = siteConfig.shortcuts.blog.latestPostCount;
const latestPostRange = `1-${latestPostCount}`;
const recentPostUrls = posts
	.slice(0, latestPostCount)
	.map((post) => getBlogPostUrl(post.id));
const kbd = (key: string) => `<span class="kbd">${key}</span>`;
const introExtra = `Press ${kbd(latestPostRange)} for the latest posts, ${kbd("j")} ${kbd("k")} to move, ${kbd("enter")} to open.`;
---

<SiteLayout
	title="Blog"
	description="Thoughts, experiments, and project writeups."
	path="/blog"
	previewPath="/blog/preview"
>
	<section class="space-y-10">
		<div class="space-y-4">
		<PageIntro
			title="Notes, builds, and rabbit holes."
			extra={posts.length > 0 ? introExtra : undefined}
		/>
		<p class="text-sm" data-reveal>
			<a class="action" href="/blog/rss.xml"><Icon name="rss" />rss feed</a>
		</p>
		</div>

		{posts.length === 0 ? (
			<p class="text-tone-soft text-sm" data-reveal>no posts yet.</p>
		) : (
			<ol class="space-y-7" data-reveal>
				{posts.map((post, index) => (
					<li data-tui-row class="space-y-1">
						<div class="flex items-baseline gap-3">
							<a class="min-w-0 font-[575] no-underline" href={getBlogPostUrl(post.id)}>
								{post.data.title}
							</a>
							{index < latestPostCount && (
								<span class="kbd shrink-0" aria-hidden="true">{index + 1}</span>
							)}
							<span aria-hidden="true" class="border-border hidden min-w-4 flex-1 -translate-y-1 border-b border-dashed sm:block"></span>
							<time class="text-tone-faint ml-auto shrink-0 font-mono text-xs">
								{formatDate(post.data.updatedDate ?? post.data.pubDate).toLowerCase()}
							</time>
						</div>
						<p class="text-tone-soft text-sm leading-6">
							{post.data.description}
						</p>
					</li>
				))}
			</ol>
		)}

	</section>

	<script
		is:inline
		define:vars={{ recentPostUrls }}
	>
		(() => {
			const editableTags = new Set(["INPUT", "TEXTAREA", "SELECT"]);

			const onBlogShortcut = (event) => {
				if (
					event.defaultPrevented ||
					event.repeat ||
					event.metaKey ||
					event.ctrlKey ||
					event.altKey
				) {
					return;
				}

				const target = event.target;

				if (
					target instanceof HTMLElement &&
					(editableTags.has(target.tagName) || target.isContentEditable)
				) {
					return;
				}

				if (!/^\d$/.test(event.key)) {
					return;
				}

				const index = Number(event.key) - 1;
				const href = recentPostUrls[index];

				if (!href) {
					return;
				}

				event.preventDefault();
				window.location.assign(href);
			};

			document.addEventListener("keydown", onBlogShortcut);
		})();
	</script>
</SiteLayout>
