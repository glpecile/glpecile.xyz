---
export interface Props {
	href: string;
	label?: string;
	/** Open in a new tab. */
	external?: boolean;
}

const { href, label = "more", external = false } = Astro.props;
---

<a
	class="site-link text-tone-soft group inline-flex items-center gap-1.5 text-sm"
	href={href}
	target={external ? "_blank" : undefined}
	rel={external ? "noopener noreferrer" : undefined}
>
	<span>{label}</span>
	<svg
		viewBox="0 0 16 16"
		aria-hidden="true"
		class="h-3.5 w-3.5 fill-current transition-transform duration-200 ease-(--ease-reveal) group-hover:rotate-45 motion-reduce:transition-none"
	>
		<path d="M3.75 4a.75.75 0 0 0 0 1.5h6.69l-7.22 7.22a.75.75 0 1 0 1.06 1.06l7.22-7.22v6.69a.75.75 0 0 0 1.5 0V4.75A.75.75 0 0 0 12.25 4h-8.5Z"></path>
	</svg>
</a>
