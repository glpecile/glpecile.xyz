---
export interface Props {
	label: string;
	/** Item count shown faint after the label. */
	count?: number;
	class?: string;
	[key: string]: unknown;
}

const { label, count, class: className, ...rest } = Astro.props;
---

<h2 class:list={["section-label", className]} {...rest}>
	{label}
	{count !== undefined && (
		<span class="ml-1 font-normal text-tone-faint tabular-nums">{count}</span>
	)}
</h2>
