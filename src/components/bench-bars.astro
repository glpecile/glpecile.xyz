---
interface Metric {
	label: string;
	unit: string;
	rows: [name: string, value: number][];
}

interface Props {
	metrics: Metric[];
	highlight: string;
	caption: string;
}

const { metrics, highlight, caption } = Astro.props;
---

<figure class="my-8 grid gap-6">
	{
		metrics.map(({ label, unit, rows }, index) => {
			const max = Math.max(...rows.map(([, value]) => value));
			const id = `bench-${index}`;
			return (
				<div>
					<p id={id} class="mb-2 font-[575] text-[0.9rem]">
						{label}
					</p>
					<ul role="list" aria-labelledby={id} class="grid list-none gap-1.5 pl-0">
						{rows.map(([name, value]) => {
							const own = name === highlight;
							return (
								<li class="mt-0 grid grid-cols-[7rem_1fr] items-center gap-3 text-[0.85rem]">
									<span class={own ? "text-foreground font-[575]" : "text-tone-soft"}>{name}</span>
									<span class="flex min-w-0 items-center gap-2">
										<span
											aria-hidden="true"
											class:list={["h-2.5 shrink-0 rounded-[4px]", own ? "bg-primary" : "bg-primary/50"]}
											style={`width: max(calc((100% - 5rem) * ${value / max}), 3px)`}
										/>
										<span class="shrink-0 font-mono whitespace-nowrap tabular-nums">
											{value} {unit}
										</span>
									</span>
								</li>
							);
						})}
					</ul>
				</div>
			);
		})
	}
	<figcaption class="text-tone-soft text-[0.85rem]">{caption}</figcaption>
</figure>
