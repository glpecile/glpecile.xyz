---
export interface Props {
	title: string;
	description?: string;
	extra?: string;
}

const { title, description, extra } = Astro.props;
---

<section class="space-y-4">
	<h1 class="page-heading text-3xl leading-tight font-bold sm:text-4xl sm:leading-tight" data-reveal>
		{title}
	</h1>
	{description && (
		<p class="text-tone-mid" data-reveal>
			{description}
		</p>
	)}
	{extra && <p class="text-tone-soft text-sm leading-6" set:html={extra} data-reveal />}
</section>
