---
import MobileDrawer from "@/components/mobile-drawer";
import { siteConfig } from "#config/site";

export interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
const navItems = siteConfig.shortcuts.nav.map((item) => ({
	...item,
	isActive: item.href === "/" ? currentPath === "/" : currentPath === item.href || currentPath.startsWith(`${item.href}/`),
}));
---

<div class="shrink-0" data-site-nav>
	<MobileDrawer menu="nav" currentPath={currentPath} client:load />
	<nav aria-label="Primary" class="hidden sm:block sm:w-auto">
		<ul class="flex items-center gap-x-5 gap-y-2 sm:justify-start">
			{navItems.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={item.isActive ? "page" : undefined}
						aria-keyshortcuts={item.shortcut}
						class:list={[
							"hover:text-foreground inline-flex items-center gap-1.5 no-underline transition-colors duration-150",
							item.isActive ? "text-foreground" : "text-tone-soft",
						]}
					>
						<span class:list={["lowercase", item.isActive && "decoration-link underline underline-offset-4"]}>{item.title}</span>
						<span class="kbd" aria-hidden="true">{item.shortcut}</span>
					</a>
				</li>
			))}
		</ul>
	</nav>
</div>
