---
interface Props {
	src: string;
	label: string;
	width?: number;
	height?: number;
}

const { src, label, width = 1100, height = 540 } = Astro.props;
---

<figure class="my-8">
	<video
		src={`${src}#t=0.001`}
		aria-label={label}
		width={width}
		height={height}
		muted
		loop
		playsinline
		controls
		preload="metadata"
		data-demo-video
		class="h-auto w-full rounded-md"
	></video>
	<figcaption class="text-tone-soft mt-3 text-center text-[0.85rem]"><slot /></figcaption>
</figure>

<script>
	if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const play = async (video: HTMLVideoElement) => {
			try {
				await video.play();
			} catch {
				return;
			}
		};
		const observer = new IntersectionObserver(
			(entries) => {
				for (const { target, isIntersecting } of entries) {
					if (!(target instanceof HTMLVideoElement)) continue;
					if (isIntersecting) void play(target);
					else target.pause();
				}
			},
			{ threshold: 0.5 },
		);
		for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-demo-video]")) {
			observer.observe(video);
		}
	}
</script>
