---
interface Props {
	src: string;
	label: string;
}

const { src, label } = Astro.props;
---

<figure class="my-8">
	<video
		src={`${src}#t=0.001`}
		aria-label={label}
		width="1100"
		height="540"
		muted
		loop
		playsinline
		controls
		preload="metadata"
		data-demo-video
		class="h-auto w-full rounded-md"
	></video>
	<figcaption class="text-tone-soft mt-3 text-center text-[0.85rem]"><slot /></figcaption>
</figure>

<script>
	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
	const visible = new WeakSet<HTMLVideoElement>();
	const readerPaused = new WeakSet<HTMLVideoElement>();
	const play = async (video: HTMLVideoElement) => {
		try {
			await video.play();
		} catch {}
	};
	const observer = new IntersectionObserver(
		(entries) => {
			for (const { target, intersectionRatio } of entries) {
				if (!(target instanceof HTMLVideoElement)) continue;
				if (intersectionRatio >= 0.5) {
					visible.add(target);
					if (!reducedMotion.matches && !readerPaused.has(target)) void play(target);
				} else {
					visible.delete(target);
					target.pause();
				}
			}
		},
		{ threshold: 0.5 },
	);
	for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-demo-video]")) {
		video.addEventListener("pause", () => {
			if (visible.has(video) && !document.hidden) readerPaused.add(video);
		});
		video.addEventListener("play", () => readerPaused.delete(video));
		observer.observe(video);
	}
</script>
