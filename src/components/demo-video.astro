---
interface Props {
	src: string;
	label: string;
}

const { src, label } = Astro.props;
---

<figure class="my-8">
	<video
		src={`${src}#t=0.001`}
		aria-label={label}
		width="1100"
		height="540"
		muted
		loop
		playsinline
		controls
		preload="metadata"
		data-demo-video
		class="h-auto w-full rounded-md"
	></video>
	<figcaption class="text-tone-soft mt-3 text-center text-[0.85rem]"><slot /></figcaption>
</figure>

<script>
	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
	const visible = new WeakSet<HTMLVideoElement>();
	const play = async (video: HTMLVideoElement) => {
		try {
			await video.play();
		} catch {
			return;
		}
	};
	const observer = new IntersectionObserver(
		(entries) => {
			for (const { target, isIntersecting } of entries) {
				if (!(target instanceof HTMLVideoElement)) continue;
				if (isIntersecting) {
					visible.add(target);
					if (!reducedMotion.matches) void play(target);
				} else {
					visible.delete(target);
					target.pause();
				}
			}
		},
		{ threshold: 0.5 },
	);
	for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-demo-video]")) {
		video.addEventListener("pause", () => {
			if (visible.has(video)) observer.unobserve(video);
		});
		observer.observe(video);
	}
</script>
