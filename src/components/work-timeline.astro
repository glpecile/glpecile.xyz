---
import type { WorkExperience } from "#config/site";
import { parseInlineLinks } from "@/lib/inline-links";

export interface Props {
	work: readonly WorkExperience[];
	detail?: "summary" | "highlights";
}

const { work, detail = "summary" } = Astro.props;
---

<ol class="border-border relative space-y-8 border-l pl-6">
	{work.map((job, index) => (
		<li class="group">
			<span class="absolute -left-[4.5px] mt-2 flex size-2 transition-[scale] duration-200 ease-(--ease-reveal) group-hover:scale-150 motion-reduce:transition-none">
				{index === 0 && (
					<span class="bg-link absolute inline-flex size-full animate-ping rounded-full opacity-60 [animation-duration:2.5s] motion-reduce:hidden" />
				)}
				<span
					class:list={[
						"ring-background relative inline-flex size-2 rounded-full ring-4",
						index === 0 ? "bg-link" : "bg-tone-faint",
					]}
				/>
			</span>
			<p>
					<span class="text-foreground font-[575]">{job.role}</span>
					<span class="text-tone-faint"> at </span>
					{job.url ? (
						<a
							class="site-link"
							href={job.url}
							target="_blank"
							rel="noopener noreferrer"
						>
							{job.company}
						</a>
					) : (
						<span>{job.company}</span>
					)}
			</p>
			<p class="text-tone-soft flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
				<span>{job.place}</span>
				<time class="text-tone-faint font-mono text-xs">{job.period}</time>
			</p>
			{detail === "highlights" && job.highlights ? (
				<ul class="marker:text-tone-faint text-tone-mid mt-2 list-disc space-y-1.5 pl-4">
					{job.highlights.map((highlight) => (
						<li>
							{parseInlineLinks(highlight).map((segment) =>
								segment.url ? (
									<a class="site-link" href={segment.url}>
										{segment.text}
									</a>
								) : (
									segment.text
								),
							)}
						</li>
					))}
				</ul>
			) : (
				(job.summary ?? job.highlights?.[0]) && (
					<p class="text-tone-mid mt-2">
						{job.summary ?? job.highlights?.[0]}
					</p>
				)
			)}
		</li>
	))}
</ol>
