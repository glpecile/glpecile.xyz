---
import { siteConfig } from "#config/site";

export interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
const themeItems = siteConfig.shortcuts.theme;

// Render the current path like a shell cwd: `~` at home, `~/blog` elsewhere.
const termPath =
	currentPath === "/" ? "~" : `~${currentPath.replace(/\/+$/, "")}`;
---

<footer class="text-tone-soft bg-background sticky bottom-0 z-10 -mx-6 mt-12 text-sm sm:-mx-8">
	<div class="border-border mx-6 border-t sm:mx-8">
		<div class="flex items-center justify-between gap-x-6 py-2">
		<span class="inline-flex min-w-0 flex-1 items-center gap-4">
			<span dir="rtl" class="text-tone-faint min-w-0 truncate text-left">&#x200E;{termPath}</span>
			<a
				class="terminal-link text-tone-mid hidden shrink-0 sm:inline"
				href={`${siteConfig.links.github}/glpecile.xyz`}
				target="_blank"
				rel="noopener noreferrer"
			>
				source code
			</a>
		</span>
		<span
			class="hidden shrink-0 items-center gap-2 text-sm sm:inline-flex"
			data-theme-picker
		>
			<span class="text-tone-faint text-[0.72rem] tracking-[0.28em] uppercase">theme</span>
			{themeItems.map((item) => (
				<button
					type="button"
					data-theme-option={item.theme}
					data-theme-shortcut={item.shortcut}
					aria-keyshortcuts={item.shortcut}
					aria-label={`${item.theme} theme`}
					class="text-tone-soft group inline-flex cursor-pointer items-center gap-1.5 px-1 focus-visible:outline-none"
				>
					<span
						data-theme-label
						class="group-hover:underline group-focus-visible:underline"
					>[{item.shortcut}]</span>
					<span
						aria-hidden="true"
						class:list={[
							"inline-block h-[0.7em] w-[0.7em] rounded-full border border-current",
							item.theme === "auto" &&
								"bg-[linear-gradient(90deg,currentColor_50%,transparent_50%)]",
							item.theme === "dark" && "bg-current",
						]}
					></span>
				</button>
			))}
		</span>
		<div class="group relative shrink-0 sm:hidden" data-footer-menu data-state="closed">
			<button
				type="button"
				aria-label="Toggle footer menu"
				aria-controls="mobile-footer-menu"
				aria-expanded="false"
				data-footer-menu-toggle
				class="text-tone-mid hover:text-foreground focus-visible:ring-foreground/30 inline-flex h-10 w-10 cursor-pointer items-center justify-center transition-colors duration-200 ease-out focus-visible:ring-1 focus-visible:outline-none motion-reduce:transition-none"
			>
				<span aria-hidden="true" class="tracking-[-0.2em]">···</span>
			</button>

			<div
				id="mobile-footer-menu"
				aria-hidden="true"
				data-footer-menu-panel
				class="border-foreground/10 bg-background pointer-events-none absolute right-0 bottom-full z-10 mb-2 min-w-44 origin-bottom-right translate-y-1 border px-4 py-3 opacity-0 transition-[opacity,transform] duration-200 ease-out group-data-[state=open]:pointer-events-auto group-data-[state=open]:translate-y-0 group-data-[state=open]:opacity-100 motion-reduce:transition-none"
			>
				<div class="flex flex-col gap-3 text-sm">
					<a
						class="terminal-link text-tone-mid"
						href={`${siteConfig.links.github}/glpecile.xyz`}
						target="_blank"
						rel="noopener noreferrer"
					>
						source code
					</a>
					<span class="inline-flex items-center gap-2" data-theme-picker>
						<span class="text-tone-faint text-[0.72rem] tracking-[0.28em] uppercase">theme</span>
						{themeItems.map((item) => (
							<button
								type="button"
								data-theme-option={item.theme}
								data-theme-shortcut={item.shortcut}
								aria-keyshortcuts={item.shortcut}
								aria-label={`${item.theme} theme`}
								class="text-tone-soft group inline-flex cursor-pointer items-center gap-1.5 px-1 focus-visible:outline-none"
							>
								<span
									data-theme-label
									class="group-hover:underline group-focus-visible:underline"
								>[{item.shortcut}]</span>
								<span
									aria-hidden="true"
									class:list={[
										"inline-block h-[0.7em] w-[0.7em] rounded-full border border-current",
										item.theme === "auto" &&
											"bg-[linear-gradient(90deg,currentColor_50%,transparent_50%)]",
										item.theme === "dark" && "bg-current",
									]}
								></span>
							</button>
						))}
					</span>
				</div>
			</div>
		</div>
		</div>
	</div>
</footer>

<script is:inline>
	(() => {
		const currentScript = document.currentScript;
		const footer =
			currentScript instanceof HTMLScriptElement ? currentScript.previousElementSibling : null;

		if (footer instanceof HTMLElement) {
			const menu = footer.querySelector("[data-footer-menu]");
			const menuToggle = footer.querySelector("[data-footer-menu-toggle]");
			const menuPanel = footer.querySelector("[data-footer-menu-panel]");

			if (
				menu instanceof HTMLElement &&
				menuToggle instanceof HTMLButtonElement &&
				menuPanel instanceof HTMLElement
			) {
				const setOpen = (open) => {
					menu.dataset.state = open ? "open" : "closed";
					menuToggle.setAttribute("aria-expanded", open ? "true" : "false");
					menuPanel.setAttribute("aria-hidden", open ? "false" : "true");
					menuPanel.inert = !open;
				};

				const closeMenu = () => {
					setOpen(false);
				};

				menuToggle.addEventListener("click", () => {
					setOpen(menu.dataset.state !== "open");
				});

				document.addEventListener("click", (event) => {
					if (menu.dataset.state !== "open") {
						return;
					}

					const target = event.target;

					if (target instanceof Node && !menu.contains(target)) {
						closeMenu();
					}
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape") {
						closeMenu();
					}
				});

				menuPanel.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", closeMenu);
				});

				setOpen(false);
			}

			const themeButtons = Array.from(footer.querySelectorAll("[data-theme-option]"));
			const themeEditableTags = new Set(["INPUT", "TEXTAREA", "SELECT"]);
			const themeMap = new Map(
				themeButtons.flatMap((button) =>
					button instanceof HTMLButtonElement &&
					typeof button.dataset.themeOption === "string" &&
					typeof button.dataset.themeShortcut === "string"
						? [[button.dataset.themeShortcut.toLowerCase(), button.dataset.themeOption]]
						: [],
				),
			);

			const setThemeButtonState = (theme) => {
				themeButtons.forEach((button) => {
					if (!(button instanceof HTMLButtonElement)) {
						return;
					}

					const isActive = button.dataset.themeOption === theme;
					const label = button.querySelector("[data-theme-label]");

					button.dataset.active = isActive ? "true" : "false";
					button.setAttribute("aria-pressed", isActive ? "true" : "false");
					button.classList.toggle("text-foreground", isActive);
					button.classList.toggle("text-tone-soft", !isActive);

					if (label instanceof HTMLElement) {
						label.classList.toggle("underline", isActive);
					}
				});
			};

			const syncThemeButtons = (theme) => {
				window.__glpecileTheme.apply(theme);
				setThemeButtonState(theme);
			};

			const storedTheme =
				window.__glpecileTheme.root.dataset.themePreference === "light" ||
				window.__glpecileTheme.root.dataset.themePreference === "dark"
					? window.__glpecileTheme.root.dataset.themePreference
					: "auto";

			syncThemeButtons(storedTheme);

			window.__glpecileTheme.media.addEventListener("change", () => {
				if (window.__glpecileTheme.root.dataset.themePreference === "auto") {
					syncThemeButtons("auto");
				}
			});

			footer.addEventListener("click", (event) => {
				const target = event.target;
				const button =
					target instanceof Element ? target.closest("[data-theme-option]") : null;

				if (!(button instanceof HTMLButtonElement)) {
					return;
				}

				const theme = button.dataset.themeOption;

				if (!theme) {
					return;
				}

				window.__glpecileTheme.persist(theme);
				syncThemeButtons(theme);
			});

			document.addEventListener("keydown", (event) => {
				if (
					event.defaultPrevented ||
					event.repeat ||
					event.metaKey ||
					event.ctrlKey ||
					event.altKey
				) {
					return;
				}

				const target = event.target;

				if (
					target instanceof HTMLElement &&
					(themeEditableTags.has(target.tagName) || target.isContentEditable)
				) {
					return;
				}

				const theme = themeMap.get(event.key.toLowerCase());

				if (!theme) {
					return;
				}

				event.preventDefault();
				window.__glpecileTheme.persist(theme);
				syncThemeButtons(theme);
			});
		}
	})();
</script>
