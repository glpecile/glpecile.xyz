---
import Icon from "@/components/icon.astro";
import MobileDrawer from "@/components/mobile-drawer";
import { siteConfig } from "#config/site";

const themeItems = siteConfig.shortcuts.theme;
---

<footer class="text-tone-soft mt-20 text-sm">
	<div aria-hidden="true" class="bg-border mb-6 h-px w-12"></div>
	<div class="flex items-center justify-between gap-x-6">
		<a
			class="action"
			href={`${siteConfig.links.github}/glpecile.xyz`}
			target="_blank"
			rel="noopener noreferrer"
		>
			<Icon name="code" />
			source code
		</a>
		<span
			class="bg-muted relative hidden rounded-full p-0.5 sm:inline-flex"
			data-theme-picker
		>
			<span aria-hidden="true" class="theme-thumb bg-card absolute inset-y-0.5 left-0.5 w-9 rounded-full"></span>
			{themeItems.map((item) => (
				<button
					type="button"
					data-theme-option={item.theme}
					data-theme-shortcut={item.shortcut}
					aria-keyshortcuts={item.shortcut}
					aria-label={`${item.theme} theme`}
					title={`${item.theme} theme (${item.shortcut})`}
					class="text-tone-soft hover:text-foreground relative grid h-7 w-9 cursor-pointer place-items-center rounded-full transition-[color,scale] duration-150 ease-(--ease-reveal) active:scale-[0.97] motion-reduce:transition-colors"
				>
					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
						class="h-4 w-4 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]"
					>
						{item.theme === "auto" && (
							<Fragment>
								<rect x="3" y="4" width="18" height="12" rx="2" />
								<path d="M8 20h8M12 16v4" />
							</Fragment>
						)}
						{item.theme === "light" && (
							<Fragment>
								<circle cx="12" cy="12" r="4" />
								<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
							</Fragment>
						)}
						{item.theme === "dark" && <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />}
					</svg>
				</button>
			))}
		</span>
		<MobileDrawer menu="footer" client:load />
	</div>
</footer>

<script is:inline>
	(() => {
		const currentScript = document.currentScript;
		const footer =
			currentScript instanceof HTMLScriptElement ? currentScript.previousElementSibling : null;

		if (footer instanceof HTMLElement) {
			const themeButtons = Array.from(footer.querySelectorAll("[data-theme-option]"));
			const themeEditableTags = new Set(["INPUT", "TEXTAREA", "SELECT"]);
			const themeMap = new Map(
				themeButtons.flatMap((button) =>
					button instanceof HTMLButtonElement &&
					typeof button.dataset.themeOption === "string" &&
					typeof button.dataset.themeShortcut === "string"
						? [[button.dataset.themeShortcut.toLowerCase(), button.dataset.themeOption]]
						: [],
				),
			);

			const setThemeButtonState = (theme) => {
				themeButtons.forEach((button) => {
					if (!(button instanceof HTMLButtonElement)) {
						return;
					}

					const isActive = button.dataset.themeOption === theme;
					button.dataset.active = isActive ? "true" : "false";
					button.setAttribute("aria-pressed", isActive ? "true" : "false");
					button.classList.toggle("text-foreground", isActive);
					button.classList.toggle("text-tone-soft", !isActive);
				});
			};

			const syncThemeButtons = (theme, animate = false) => {
				footer.dataset.instant = String(!animate);
				window.__glpecileTheme.apply(theme);
				setThemeButtonState(theme);
			};

			const storedTheme =
				window.__glpecileTheme.root.dataset.themePreference === "light" ||
				window.__glpecileTheme.root.dataset.themePreference === "dark"
					? window.__glpecileTheme.root.dataset.themePreference
					: "auto";

			syncThemeButtons(storedTheme);

			window.__glpecileTheme.media.addEventListener("change", () => {
				if (window.__glpecileTheme.root.dataset.themePreference === "auto") {
					syncThemeButtons("auto");
				}
			});

			footer.addEventListener("click", (event) => {
				const target = event.target;
				const button =
					target instanceof Element ? target.closest("[data-theme-option]") : null;

				if (!(button instanceof HTMLButtonElement)) {
					return;
				}

				const theme = button.dataset.themeOption;

				if (!theme) {
					return;
				}

				window.__glpecileTheme.persist(theme);
				syncThemeButtons(theme, event.detail > 0);
			});

			document.addEventListener("keydown", (event) => {
				if (
					event.defaultPrevented ||
					event.repeat ||
					event.metaKey ||
					event.ctrlKey ||
					event.altKey
				) {
					return;
				}

				const target = event.target;

				if (
					target instanceof HTMLElement &&
					(themeEditableTags.has(target.tagName) || target.isContentEditable)
				) {
					return;
				}

				const theme = themeMap.get(event.key.toLowerCase());

				if (!theme) {
					return;
				}

				event.preventDefault();
				window.__glpecileTheme.persist(theme);
				syncThemeButtons(theme);
			});
		}
	})();
</script>
