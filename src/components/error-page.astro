---
import { siteConfig } from "#config/site";

import SiteLayout from "@/layouts/site-layout.astro";

export interface Props {
	code: string;
	title: string;
	description: string;
	hint?: string;
	error?: unknown;
	path?: string;
}

const { code, title, description, hint, error, path = "/" } = Astro.props;
const navItems = siteConfig.shortcuts.nav.map((item) => ({
	...item,
	label: item.title.toLowerCase(),
}));

const details =
	error instanceof Error
		? error.message
		: typeof error === "string"
			? error
			: undefined;
---

<SiteLayout title={`${code} | ${title}`} description={description} path={path}>
	<section class="space-y-6">
		<div class="space-y-3">
			<p class="font-mono text-xs text-tone-faint">{code}</p>
			<h1 class="page-heading text-3xl leading-tight font-bold sm:text-4xl sm:leading-tight">
				{title}
			</h1>
			<p class="text-tone-mid">{description}</p>
			{hint && <p class="text-sm text-tone-soft">{hint}</p>}
		</div>

		<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
			{navItems.map((item) => (
				<a
					href={item.href}
					class="site-link inline-flex items-center gap-1.5"
					aria-keyshortcuts={item.shortcut}
				>
					<span>{item.label}</span>
					<span class="kbd" aria-hidden="true">
						{item.shortcut}
					</span>
				</a>
			))}
		</div>

		{details && <pre class="overflow-x-auto border-l-2 border-border pl-4 font-mono text-xs leading-6 text-tone-soft">{details}</pre>}
	</section>
</SiteLayout>
