---
import type { MarkdownHeading } from "astro";

import SectionLabel from "@/components/section-label.astro";

export interface Props {
	title: string;
	headings: MarkdownHeading[];
}

const { title } = Astro.props;
const headings = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
	headings.length > 0 && (
		<nav
			aria-label="Table of contents"
			class="fixed top-44.5 right-[calc(50%+30rem)] hidden w-64 space-y-5 text-sm 2xl:block"
			data-post-toc
		>
			<a
				href="#"
				title="Back to top"
				class="text-foreground invisible absolute bottom-full mb-5 block w-full translate-y-1 leading-6 font-bold no-underline opacity-0 blur-[2px] transition-[opacity,translate,filter,visibility] duration-200 ease-(--ease-reveal) data-visible:visible data-visible:translate-y-0 data-visible:opacity-100 data-visible:blur-none motion-reduce:translate-y-0 motion-reduce:blur-none"
				data-toc-title
			>
				{title}
			</a>
			<SectionLabel label="tree" rule={false} />
			<ol class="space-y-1.5">
				{headings.map(({ depth, slug, text }) => (
					<li class:list={["flex gap-2", depth === 3 && "pl-4"]}>
						<span aria-hidden="true" class="text-tone-faint">
							└
						</span>
						<a
							href={`#${slug}`}
							class="text-tone-soft hover:text-foreground aria-[current=location]:text-foreground truncate no-underline transition-colors duration-200"
							title={text}
						>
							{text}
						</a>
					</li>
				))}
			</ol>
			<p class="text-tone-soft flex items-center gap-3 tabular-nums" aria-hidden="true">
				<span class="bg-border h-2 w-40 overflow-hidden">
					<span class="bg-tone-soft block h-full w-0" data-toc-bar></span>
				</span>
				<span data-toc-percent>0%</span>
			</p>
		</nav>
	)
}

<script is:inline>
	// Runs before the article is parsed (the toc renders first), so defer all
	// lookups until the headings and h1 exist.
	document.addEventListener("DOMContentLoaded", () => {
		const toc = document.querySelector("[data-post-toc]");

		if (!(toc instanceof HTMLElement)) {
			return;
		}

		const links = Array.from(toc.querySelectorAll("ol a"));
		const targets = links.map((link) =>
			document.getElementById(link.getAttribute("href").slice(1)),
		);
		const bar = toc.querySelector("[data-toc-bar]");
		const percent = toc.querySelector("[data-toc-percent]");
		const title = toc.querySelector("[data-toc-title]");
		const heading = document.querySelector("article h1");

		// Matches the rail's `2xl:block`; below it the toc is display:none, so skip
		// the per-scroll layout reads entirely.
		const wide = window.matchMedia("(min-width: 96rem)");

		const update = () => {
			if (!wide.matches) {
				return;
			}

			const max = document.documentElement.scrollHeight - window.innerHeight;
			const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 1;

			bar.style.width = `${progress * 100}%`;
			percent.textContent = `${Math.round(progress * 100)}%`;
			// Title only once the post's own h1 has scrolled out of view.
			title.toggleAttribute("data-visible", (heading?.getBoundingClientRect().bottom ?? 1) <= 0);

			// Active section: last heading scrolled past the top third of the viewport,
			// or the final one at the bottom so short trailing sections still light up.
			const active =
				progress === 1
					? links.length - 1
					: targets.findLastIndex(
							(target) =>
								target && target.getBoundingClientRect().top < window.innerHeight / 3,
						);
			links.forEach((link, index) => {
				if (index === active) {
					link.setAttribute("aria-current", "location");
				} else {
					link.removeAttribute("aria-current");
				}
			});
		};

		const scrollBehavior = () =>
			window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";

		title.addEventListener("click", (event) => {
			event.preventDefault();
			window.scrollTo({ top: 0, behavior: scrollBehavior() });
			window.history.pushState(null, "", window.location.pathname);
		});

		// Smooth-scroll to sections on click; stays instant under reduced motion.
		links.forEach((link, index) => {
			link.addEventListener("click", (event) => {
				const target = targets[index];

				if (!target) {
					return;
				}

				event.preventDefault();
				target.scrollIntoView({ behavior: scrollBehavior() });
				window.history.pushState(null, "", link.getAttribute("href"));
			});
		});

		window.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
		window.addEventListener("load", update);
		wide.addEventListener("change", update);
		update();
	});
</script>
