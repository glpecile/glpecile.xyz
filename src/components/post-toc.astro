---
import type { MarkdownHeading } from "astro";

import SectionLabel from "@/components/section-label.astro";

export interface Props {
	title: string;
	headings: MarkdownHeading[];
}

const { title } = Astro.props;
const headings = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
	headings.length > 0 && (
		<nav
			aria-label="Table of contents"
			class="fixed top-24 right-[calc(50%+30rem)] hidden w-64 space-y-5 text-sm 2xl:block"
			data-post-toc
		>
			<p class="text-foreground invisible leading-6 font-bold" data-toc-title>
				{title}
			</p>
			<SectionLabel label="tree" rule={false} />
			<ol class="space-y-1.5">
				{headings.map(({ depth, slug, text }) => (
					<li class:list={["flex gap-2", depth === 3 && "pl-4"]}>
						<span aria-hidden="true" class="text-tone-faint">
							└
						</span>
						<a
							href={`#${slug}`}
							class="text-tone-soft hover:text-foreground aria-[current=location]:text-foreground truncate no-underline"
							title={text}
						>
							{text}
						</a>
					</li>
				))}
			</ol>
			<p class="text-tone-soft flex gap-3 tabular-nums" aria-hidden="true">
				<span class="whitespace-pre" data-toc-bar></span>
				<span data-toc-percent>0%</span>
			</p>
		</nav>
	)
}

<script is:inline>
	(() => {
		const toc = document.querySelector("[data-post-toc]");

		if (!(toc instanceof HTMLElement)) {
			return;
		}

		const links = Array.from(toc.querySelectorAll("a[href^='#']"));
		const targets = links.map((link) =>
			document.getElementById(link.getAttribute("href").slice(1)),
		);
		const bar = toc.querySelector("[data-toc-bar]");
		const percent = toc.querySelector("[data-toc-percent]");
		const title = toc.querySelector("[data-toc-title]");
		const heading = document.querySelector("article h1");
		const width = 20;

		const update = () => {
			const max = document.documentElement.scrollHeight - window.innerHeight;
			const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 1;
			const filled = Math.round(progress * width);

			bar.textContent = "█".repeat(filled) + "░".repeat(width - filled);
			percent.textContent = `${Math.round(progress * 100)}%`;
			// Title only once the post's own h1 has scrolled out of view.
			title.classList.toggle("invisible", (heading?.getBoundingClientRect().bottom ?? 1) > 0);

			// Active section: last heading scrolled past the top third of the viewport,
			// or the final one at the bottom so short trailing sections still light up.
			const active =
				progress === 1
					? links.length - 1
					: targets.findLastIndex(
							(target) =>
								target && target.getBoundingClientRect().top < window.innerHeight / 3,
						);
			links.forEach((link, index) => {
				if (index === active) {
					link.setAttribute("aria-current", "location");
				} else {
					link.removeAttribute("aria-current");
				}
			});
		};

		window.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
		// This script runs before the article is parsed; wait for the full page
		// height or the bar reads 100% on load.
		document.addEventListener("DOMContentLoaded", update);
		window.addEventListener("load", update);
	})();
</script>
