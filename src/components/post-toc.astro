---
import type { MarkdownHeading } from "astro";

import SectionLabel from "@/components/section-label.astro";

export interface Props {
	headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter(({ depth }) => depth <= 3);
---

{
	headings.length > 0 && (
		<nav
			aria-label="Table of contents"
			class="fixed top-24 right-[calc(50%+30rem)] hidden w-64 space-y-5 text-sm 2xl:block"
			data-post-toc
		>
			<SectionLabel label="tree" rule={false} />
			<ol class="space-y-1.5">
				{headings.map(({ depth, slug, text }) => (
					<li class:list={["flex gap-2", depth === 3 && "pl-4"]}>
						<span aria-hidden="true" class="text-tone-faint">
							└
						</span>
						<a
							href={`#${slug}`}
							class="text-tone-soft hover:text-foreground aria-[current=location]:text-foreground truncate no-underline"
							title={text}
						>
							{text}
						</a>
					</li>
				))}
			</ol>
			<p class="text-tone-soft flex gap-3 tabular-nums" aria-hidden="true">
				<span class="whitespace-pre" data-toc-bar>
					{"░".repeat(20)}
				</span>
				<span data-toc-percent>0%</span>
			</p>
			<p class="section-label text-tone-faint">press ↑ / ↓ to scroll</p>
		</nav>
	)
}

<script is:inline>
	(() => {
		const toc = document.querySelector("[data-post-toc]");

		if (!(toc instanceof HTMLElement)) {
			return;
		}

		const links = Array.from(toc.querySelectorAll("a[href^='#']"));
		const targets = links.map((link) =>
			document.getElementById(decodeURIComponent(link.hash.slice(1))),
		);
		const bar = toc.querySelector("[data-toc-bar]");
		const percent = toc.querySelector("[data-toc-percent]");
		const width = 20;
		let frame = 0;

		const update = () => {
			frame = 0;
			const max = document.documentElement.scrollHeight - window.innerHeight;
			const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 1;
			const filled = Math.round(progress * width);

			bar.textContent = "▓".repeat(filled) + "░".repeat(width - filled);
			percent.textContent = `${Math.round(progress * 100)}%`;

			// Active section: last heading scrolled past the top third of the viewport.
			let active = -1;
			targets.forEach((target, index) => {
				if (target && target.getBoundingClientRect().top < window.innerHeight / 3) {
					active = index;
				}
			});
			links.forEach((link, index) => {
				if (index === active) {
					link.setAttribute("aria-current", "location");
				} else {
					link.removeAttribute("aria-current");
				}
			});
		};

		const schedule = () => {
			if (!frame) {
				frame = window.requestAnimationFrame(update);
			}
		};

		window.addEventListener("scroll", schedule, { passive: true });
		window.addEventListener("resize", schedule);
		update();
	})();
</script>
